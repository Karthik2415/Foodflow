rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerOrAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }

    // Invoices PDF directory
    match /invoices/{invoiceId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwnerOrAdmin() || request.auth.token.role == 'accountant';
    }

    // Product Images
    match /products/{productId}/{fileName} {
      allow read: if true; // Public access for salesman catalogue
      allow write: if isOwnerOrAdmin();
    }

    // Company logo & branding
    match /branding/{fileName} {
      allow read: if true;
      allow write: if isOwnerOrAdmin();
    }
  }
}
